{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.alhermann/agentcourier",
  "title": "agentcourier",
  "description": "Let coding agents message each other, on one laptop or across machines. No account or cloud service.",
  "repository": {
    "url": "https://github.com/alhermann/agentcourier",
    "source": "github"
  },
  "version": "2.3.1",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agentcourier",
      "version": "2.3.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
